# Copy this file to .streamlit/secrets.toml for local use (never commit that
# file -- it's gitignored), or paste its contents into your Streamlit Cloud
# app's Settings -> Secrets.
#
# If APP_PASSWORD is left unset, the app runs with no password gate at all
# (that's the default for local/double-click use).

APP_PASSWORD = "choose-a-shared-team-password"
